# 14. Suggested execution modes
# ------------------------------------------------------------
run_quick_pilot <- function() {
order <- run_order_facet_study(
d_values = c(4L, 5L, 10L),
covariance_names = c("Identity", "AR_0.5"),
lambda_values = c(0, 0.75, 1.25),
B = 5000L,
ptol = 2.5e-4,
maxiter = 1000L,
maxpts = 250000L,
abseps = 1e-5,
run_postfacet_checks = TRUE,
postfacet_B = 2000L
)
affine <- run_affine_simplex_study(
d_values = c(2L, 4L),
covariance_names = c("Identity", "AR_0.5"),
delta_values = c(0.5, 1.0),
B = 5000L,
ptol = 2.5e-4,
maxiter = 1000L,
maxpts = 250000L,
abseps = 1e-5,
run_postfacet_checks = TRUE,
postfacet_B = 2000L
)
list(order = order, affine = affine)
}
run_main_study <- function() {
order <- run_order_facet_study(
d_values = c(4L, 5L, 10L, 20L),
covariance_names = c(
"Identity",
"CS_0.5",
"AR_0.5",
"AR_0.8",
"Toeplitz_MA",
"Heteroskedastic_AR"
),
lambda_values = c(0, 0.5, 1.0, 1.5, 2.0),
B = 50000L,
ptol = 1e-4,
maxiter = 2000L,
maxpts = 1000000L,
abseps = 1e-6,
run_postfacet_checks = TRUE,
postfacet_B = 5000L
)
affine <- run_affine_simplex_study(
d_values = c(2L, 4L, 6L),
covariance_names = c("Identity", "AR_0.5", "Heteroskedastic_AR"),
delta_values = c(0.5, 1.0, 1.5),
B = 50000L,
ptol = 1e-4,
maxiter = 2000L,
maxpts = 1000000L,
abseps = 1e-6,
run_postfacet_checks = TRUE,
postfacet_B = 5000L
)
list(order = order, affine = affine)
}
# ------------------------------------------------------------
# 15. Minimal manual checks before a large run
# ------------------------------------------------------------
manual_preflight_checks <- function(run_statistical_postfacet_check = TRUE) {
d <- 4L
# Homogeneous order example.
order_reps <- make_order_representations(d)
order_eq <- lapply(order_reps, function(H) {
check_homogeneous_equivalence(order_reps$Facets, H)$equivalent
})
order_canonical <- lapply(order_reps, function(H) {
canonicalize_facets(H, rep(0, nrow(H)))
})
# Verify that the pure sparse pattern really produces the requested
# standardized facet means.
Sigma_order <- identity_covariance(d)
single_pattern <- order_alternative_patterns(d)$Single_active_facet
theta_single <- make_order_theta(
d = d,
Sigma = Sigma_order,
pattern = single_pattern,
lambda = 1
)
Hf <- order_reps$Facets
sdf <- sqrt(diag(Hf %*% Sigma_order %*% t(Hf)))
realized_standardized_means <- drop(Hf %*% theta_single) / sdf
# Affine simplex example.
simplex_reps <- make_simplex_representations(d)
simplex_eq <- lapply(simplex_reps, function(rep) {
check_affine_equivalence(
simplex_reps$Facets$H,
simplex_reps$Facets$zeta,
rep$H,
rep$zeta
)$equivalent
})
simplex_canonical <- lapply(simplex_reps, function(rep) {
canonicalize_facets(rep$H, rep$zeta)
})
simplex_nulls <- simplex_null_scenarios(d)
simplex_null_membership <- vapply(
simplex_nulls,
function(theta) {
is_in_polyhedron(
theta,
simplex_reps$Facets$H,
simplex_reps$Facets$zeta
)
},
logical(1)
)
out <- list(
order_equivalent = order_eq,
order_canonical_rows = vapply(
order_canonical,
function(x) nrow(x$H),
integer(1)
),
order_all_canonical_equal = all(vapply(
order_reps,
function(H) canonical_representations_equal(
order_reps$Facets,
rep(0, nrow(order_reps$Facets)),
H,
rep(0, nrow(H))
),
logical(1)
)),
order_single_active_target = single_pattern,
order_single_active_realized = realized_standardized_means,
order_single_active_signal_correct = max(abs(
single_pattern - realized_standardized_means
)) <= 1e-8,
simplex_equivalent = simplex_eq,
simplex_canonical_rows = vapply(
simplex_canonical,
function(x) nrow(x$H),
integer(1)
),
simplex_all_canonical_equal = all(vapply(
simplex_reps,
function(rep) canonical_representations_equal(
simplex_reps$Facets$H,
simplex_reps$Facets$zeta,
rep$H,
rep$zeta
),
logical(1)
)),
simplex_null_membership = simplex_null_membership,
simplex_all_named_nulls_valid = all(simplex_null_membership)
)
if (isTRUE(run_statistical_postfacet_check)) {
order_H <- order_reps
order_zeta <- lapply(order_H, function(H) rep(0, nrow(H)))
order_post <- post_facet_invariance_check(
H_list = order_H,
zeta_list = order_zeta,
theta = rep(0, d),
Sigma = Sigma_order,
B = 500L,
data_seed = 20260824L,
ptol = 1e-3,
maxiter = 250L,
maxpts = 50000L,
abseps = 1e-4
)
simplex_H <- lapply(simplex_reps, `[[`, "H")
simplex_zeta <- lapply(simplex_reps, `[[`, "zeta")
simplex_post <- post_facet_invariance_check(
H_list = simplex_H,
zeta_list = simplex_zeta,
theta = rep(0, d),
Sigma = identity_covariance(d),
B = 500L,
data_seed = 20260825L,
ptol = 1e-3,
maxiter = 250L,
maxpts = 50000L,
abseps = 1e-4
)
out$order_postfacet_check <- order_post
out$order_postfacet_all_passed <- all(order_post$passed)
out$simplex_postfacet_check <- simplex_post
out$simplex_postfacet_all_passed <- all(simplex_post$passed)
}
out
}
# ============================================================
# Example usage
# ============================================================
#
# preflight <- manual_preflight_checks()
# print(preflight)
#
# pilot <- run_quick_pilot()
# write_study_outputs(
#   order_study = pilot$order,
#   affine_study = pilot$affine,
#   output_dir = "mct_one_sided_facet_pilot_v2"
# )
#
# After inspecting the pilot:
# main <- run_main_study()
# write_study_outputs(
#   order_study = main$order,
#   affine_study = main$affine,
#   output_dir = "mct_one_sided_facet_main_v2"
# )
# ============================================================
preflight <- manual_preflight_checks()
print(preflight)
pilot <- run_quick_pilot()
write_study_outputs(
order_study = pilot$order,
affine_study = pilot$affine,
output_dir = "DEIN/PFAD/mct_one_sided_facet_pilot_v2"
)
