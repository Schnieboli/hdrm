max_stat_max_abs_diff = stat_diff,
decision_disagreement_seed1 = disagreement1,
decision_disagreement_seed2 = disagreement2,
passed = same_dim &&
H_diff <= structural_tol &&
zeta_diff <= structural_tol &&
R_diff <= structural_tol &&
stat_diff <= structural_tol &&
crit1_diff <= critical_tol &&
crit2_diff <= critical_tol &&
disagreement1 == 0 &&
disagreement2 == 0,
stringsAsFactors = FALSE
)
}
do.call(rbind, rows)
}
# Backward-compatible wrapper returning the richer diagnostic table.
simulate_after_facet_reduction <- function(H_list,
zeta_list,
theta,
Sigma,
B = 2000L,
data_seed = 20260823L,
alpha = 0.05,
qmvnorm_seeds = c(1L, 2L),
ptol = 2.5e-4,
maxiter = 1000L,
maxpts = 250000L,
abseps = 1e-5,
releps = 0) {
post_facet_invariance_check(
H_list = H_list,
zeta_list = zeta_list,
theta = theta,
Sigma = Sigma,
B = B,
data_seed = data_seed,
alpha = alpha,
qmvnorm_seeds = qmvnorm_seeds,
ptol = ptol,
maxiter = maxiter,
maxpts = maxpts,
abseps = abseps,
releps = releps
)
}
# ------------------------------------------------------------
# 13. Output helpers
# ------------------------------------------------------------
order_power_vs_facets <- function(results) {
power <- results[results$scenario_class == "alternative", , drop = FALSE]
facets <- power[power$representation == "Facets", c(
"d", "covariance", "scenario", "lambda",
"rejection_seed1", "rejection_seed2"
), drop = FALSE]
names(facets)[names(facets) == "rejection_seed1"] <- "facet_rejection_seed1"
names(facets)[names(facets) == "rejection_seed2"] <- "facet_rejection_seed2"
out <- merge(
power,
facets,
by = c("d", "covariance", "scenario", "lambda"),
all.x = TRUE,
sort = FALSE
)
out$power_difference_vs_facets_seed1 <-
out$rejection_seed1 - out$facet_rejection_seed1
out$power_difference_vs_facets_seed2 <-
out$rejection_seed2 - out$facet_rejection_seed2
out
}
affine_power_vs_facets <- function(results) {
power <- results[results$scenario_class == "alternative", , drop = FALSE]
facets <- power[power$representation == "Facets", c(
"d", "covariance", "scenario", "delta",
"rejection_seed1", "rejection_seed2"
), drop = FALSE]
names(facets)[names(facets) == "rejection_seed1"] <- "facet_rejection_seed1"
names(facets)[names(facets) == "rejection_seed2"] <- "facet_rejection_seed2"
out <- merge(
power,
facets,
by = c("d", "covariance", "scenario", "delta"),
all.x = TRUE,
sort = FALSE
)
out$power_difference_vs_facets_seed1 <-
out$rejection_seed1 - out$facet_rejection_seed1
out$power_difference_vs_facets_seed2 <-
out$rejection_seed2 - out$facet_rejection_seed2
out
}
affine_observed_worst_null <- function(results) {
null <- results[results$scenario_class == "null", , drop = FALSE]
if (nrow(null) == 0L) {
return(data.frame())
}
group <- interaction(
null$d,
null$covariance,
null$representation,
drop = TRUE,
lex.order = TRUE
)
rows <- lapply(split(null, group), function(x) {
x[which.max(x$rejection_seed1), , drop = FALSE]
})
out <- do.call(rbind, rows)
rownames(out) <- NULL
out
}
write_study_outputs <- function(order_study,
affine_study,
output_dir = "mct_one_sided_facet_results_v2") {
dir.create(output_dir, showWarnings = FALSE, recursive = TRUE)
# Full outputs retained for backward compatibility.
write.csv(
order_study$results,
file.path(output_dir, "order_results.csv"),
row.names = FALSE
)
write.csv(
order_study$disagreements,
file.path(output_dir, "order_disagreements.csv"),
row.names = FALSE
)
write.csv(
order_study$facet_checks,
file.path(output_dir, "order_facet_checks.csv"),
row.names = FALSE
)
write.csv(
affine_study$results,
file.path(output_dir, "affine_results.csv"),
row.names = FALSE
)
write.csv(
affine_study$disagreements,
file.path(output_dir, "affine_disagreements.csv"),
row.names = FALSE
)
write.csv(
affine_study$facet_checks,
file.path(output_dir, "affine_facet_checks.csv"),
row.names = FALSE
)
# Split outputs make null control, power, and post-reduction invariance
# directly inspectable without filtering the full tables manually.
write.csv(
order_study$results[order_study$results$scenario_class == "null", , drop = FALSE],
file.path(output_dir, "order_null_results.csv"),
row.names = FALSE
)
write.csv(
order_study$results[order_study$results$scenario_class == "alternative", , drop = FALSE],
file.path(output_dir, "order_power_results.csv"),
row.names = FALSE
)
write.csv(
order_power_vs_facets(order_study$results),
file.path(output_dir, "order_power_vs_facets.csv"),
row.names = FALSE
)
write.csv(
order_study$disagreements[
order_study$disagreements$scenario_class == "null", , drop = FALSE
],
file.path(output_dir, "order_null_disagreements.csv"),
row.names = FALSE
)
write.csv(
order_study$disagreements[
order_study$disagreements$scenario_class == "alternative", , drop = FALSE
],
file.path(output_dir, "order_power_disagreements.csv"),
row.names = FALSE
)
write.csv(
order_study$postfacet_checks,
file.path(output_dir, "order_postfacet_invariance_checks.csv"),
row.names = FALSE
)
write.csv(
affine_study$results[affine_study$results$scenario_class == "null", , drop = FALSE],
file.path(output_dir, "affine_null_results.csv"),
row.names = FALSE
)
write.csv(
affine_study$results[affine_study$results$scenario_class == "alternative", , drop = FALSE],
file.path(output_dir, "affine_power_results.csv"),
row.names = FALSE
)
write.csv(
affine_power_vs_facets(affine_study$results),
file.path(output_dir, "affine_power_vs_facets.csv"),
row.names = FALSE
)
write.csv(
affine_study$disagreements[
affine_study$disagreements$scenario_class == "null", , drop = FALSE
],
file.path(output_dir, "affine_null_disagreements.csv"),
row.names = FALSE
)
write.csv(
affine_study$disagreements[
affine_study$disagreements$scenario_class == "alternative", , drop = FALSE
],
file.path(output_dir, "affine_power_disagreements.csv"),
row.names = FALSE
)
write.csv(
affine_study$postfacet_checks,
file.path(output_dir, "affine_postfacet_invariance_checks.csv"),
row.names = FALSE
)
write.csv(
affine_observed_worst_null(affine_study$results),
file.path(output_dir, "affine_observed_worst_null.csv"),
row.names = FALSE
)
saveRDS(
list(order = order_study, affine = affine_study),
file.path(output_dir, "one_sided_facet_study_v2.rds")
)
invisible(normalizePath(output_dir, winslash = "/", mustWork = FALSE))
}
